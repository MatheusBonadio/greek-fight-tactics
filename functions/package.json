    "openai": "7.15.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.2",
    "firebase": "12.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
