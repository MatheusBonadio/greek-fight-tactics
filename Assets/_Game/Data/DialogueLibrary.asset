        text: "Ouvi na \xE1gora que a filha de Aristeu ensina a duvidar dos deuses."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
          except: 
        effects: []
        choices: []
      - speaker: kleia
        text: "Eu perguntei a um homem o que ele queria dizer com \xE2nfora. Foi s\xF3 isso."
