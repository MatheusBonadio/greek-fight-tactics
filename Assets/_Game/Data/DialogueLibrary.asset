%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aacd5c80ac949f84da50e74214e4890a, type: 3}
  m_Name: DialogueLibrary
  m_EditorClassIdentifier: Game.Content::Game.Content.DialogueLibrarySO
  speakers:
  - key: kleia
    value:
      displayName: Kleia
      portrait: kleia
  - key: menexeno
    value:
      displayName: Menexeno
      portrait: menexeno
  - key: eudoro
    value:
      displayName: Eudoro
      portrait: eudoro
  - key: neighbor
    value:
      displayName: Vizinho
      portrait: citizen
  - key: aristeu
    value:
      displayName: Aristeu
      portrait: aristeu
  - key: thrasybios
    value:
      displayName: Thrasybios
      portrait: thrasybios
  - key: customer
    value:
      displayName: "Fregu\xEAs"
      portrait: citizen
  - key: crowd
    value:
      displayName: Plateia
      portrait: 
  - key: damaris
    value:
      displayName: Damaris
      portrait: damaris
  dialogues:
  - key: kerameikos_first_steps
    value:
      lines:
      - speaker: 
        text: "Cer\xE2mico, bairro dos oleiros. Kleia termina o \xFAltimo meandro de uma \xE2nfora de figuras vermelhas."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Pronto. Mais uma borda que ningu\xE9m na \xE1gora vai reparar."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "Mova o cursor com o mouse, as setas ou o direcional. Clique ou confirme numa c\xE9lula e Kleia caminha at\xE9 l\xE1 pelo caminho mais curto."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: kerameikos_tutorial_fog
    value:
      lines:
      - speaker: 
        text: "A n\xE9voa cobre o que Kleia ainda n\xE3o viu. A cada passo, a oficina se revela ao redor dela."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "O que ela j\xE1 viu continua \xE0 vista, mesmo depois de sair do Cer\xE2mico."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: kerameikos_tutorial_talk
    value:
      lines:
      - speaker: 
        text: "Para conversar, aponte uma pessoa e confirme: Kleia vai at\xE9 ela. Aristeu, o pai, espera no fundo da oficina, junto \xE0s \xE2nforas."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: aristeu_workshop
    value:
      lines:
      - speaker: aristeu
        text: Kleia. Larga o pincel um instante, filha.
        conditions:
        - flag: aristeu_errand
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: Falta a borda. Dois meandros e ela fica pronta.
        conditions:
        - flag: aristeu_errand
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "Sempre faltam dois meandros. Olha para c\xE1."
        conditions:
        - flag: aristeu_errand
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: 
        text: "Aristeu ergue as m\xE3os. Os dedos se dobram para dentro, os n\xF3s inchados como ra\xEDzes de oliveira. Ele j\xE1 n\xE3o consegue fechar a m\xE3o em volta de uma al\xE7a."
        conditions:
        - flag: aristeu_errand
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "Hoje n\xE3o aguento o peso de uma \xE2nfora cheia at\xE9 a \xE1gora. As da porta est\xE3o prontas. Leva e vende no mercado."
        conditions:
        - flag: aristeu_errand
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: "Pelo pre\xE7o de sempre?"
        conditions:
        - flag: aristeu_errand
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "O de sempre. E n\xE3o para para ouvir discuss\xE3o de homem na \xE1gora. Discuss\xE3o n\xE3o paga o forno."
        conditions:
        - flag: aristeu_errand
          value: 
          absent: 1
        effects:
        - flag: aristeu_errand
          value: true
        choices: []
      - speaker: aristeu
        text: "As \xE2nforas est\xE3o na porta. A \xE1gora fica no fim da rua de terra, depois da herma."
        conditions:
        - flag: aristeu_errand
          value: 
          absent: 0
        - flag: duel_thrasybios
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "J\xE1 voltou? Pela sua cara, a \xE1gora te vendeu alguma coisa em vez de comprar."
        conditions:
        - flag: duel_thrasybios
          value: 
          absent: 0
        - flag: maieutics_unlocked
          value: 
          absent: 1
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "Aquele velho que te esperava na porta... N\xE3o gosto de quem ensina de gra\xE7a, filha. Sempre cobra de outro jeito."
        conditions:
        - flag: maieutics_unlocked
          value: 
          absent: 0
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "Hoje um fregu\xEAs me perguntou se \xE9 verdade que minha filha ensina a duvidar dos deuses."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        - flag: pressure_deserted
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: "Eu s\xF3 perguntei a um homem o que ele queria dizer com \xE2nfora."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        - flag: pressure_deserted
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "Eu sei, filha. Mas na \xE1gora uma pergunta corre mais depressa que a resposta."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        - flag: pressure_deserted
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: 
        text: "Aristeu est\xE1 sentado diante das \xE2nforas prontas, as m\xE3os tortas abertas sobre os joelhos."
        conditions:
        - flag: pressure_deserted
          value: 
          absent: 0
        - flag: pressure_tools
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "Ningu\xE9m veio buscar nada. Nem os de sempre."
        conditions:
        - flag: pressure_deserted
          value: 
          absent: 0
        - flag: pressure_tools
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "J\xE1 vendi os pinc\xE9is finos a um oleiro da outra rua. Se at\xE9 a lua nova ningu\xE9m comprar, a roda vai atr\xE1s."
        conditions:
        - flag: pressure_deserted
          value: 
          absent: 0
        - flag: pressure_tools
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: "N\xE3o venda a roda. Eu vendo as \xE2nforas na \xE1gora."
        conditions:
        - flag: pressure_deserted
          value: 
          absent: 0
        - flag: pressure_tools
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: "Na \xE1gora agora te chamam de \xEDmpia, filha. Quem compra de uma \xEDmpia?"
        conditions:
        - flag: pressure_deserted
          value: 
          absent: 0
        - flag: pressure_tools
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: aristeu
        text: Vendi a roda, Kleia.
        conditions:
        - flag: pressure_tools
          value: 
          absent: 0
        - flag: damaris_branch
          value: undecided
          absent: 0
        effects: []
        choices: []
      - speaker: kleia
        text: "Era a roda do av\xF4."
        conditions:
        - flag: pressure_tools
          value: 
          absent: 0
        - flag: damaris_branch
          value: undecided
          absent: 0
        effects: []
        choices: []
      - speaker: aristeu
        text: "Era. Com estas m\xE3os eu j\xE1 n\xE3o girava. Ao menos o forno fica aceso mais um m\xEAs."
        conditions:
        - flag: pressure_tools
          value: 
          absent: 0
        - flag: damaris_branch
          value: undecided
          absent: 0
        effects: []
        choices: []
      - speaker: aristeu
        text: "Duzentas dracmas numa bolsa estrangeira. N\xE3o vou perguntar de onde vieram, porque n\xE3o quero ouvir a resposta."
        conditions:
        - flag: damaris_branch
          value: accepted
          absent: 0
        effects: []
        choices: []
      - speaker: kleia
        text: "D\xE1 para comprar a roda de volta."
        conditions:
        - flag: damaris_branch
          value: accepted
          absent: 0
        effects: []
        choices: []
      - speaker: aristeu
        text: "D\xE1. Mas eu ia girar aquela roda pensando em quem pagou por ela."
        conditions:
        - flag: damaris_branch
          value: accepted
          absent: 0
        effects: []
        choices: []
      - speaker: aristeu
        text: "Dizem na rua que uma estrangeira veio te procurar com dinheiro. E que voc\xEA mandou embora."
        conditions:
        - flag: damaris_branch
          value: refused
          absent: 0
        effects: []
        choices: []
      - speaker: kleia
        text: Ela queria que eu falasse por ela. Pelo lado que ela escolhesse.
        conditions:
        - flag: damaris_branch
          value: refused
          absent: 0
        effects: []
        choices: []
      - speaker: aristeu
        text: "Ent\xE3o fez bem. Barro se compra na beira do rio. A voz da gente, n\xE3o."
        conditions:
        - flag: damaris_branch
          value: refused
          absent: 0
        effects: []
        choices: []
      branches: []
  - key: menexeno_door_offer
    value:
      lines:
      - speaker: 
        text: "O velho de manto encardido est\xE1 parado diante da oficina, apoiado no bast\xE3o de oliveira. Seguiu Kleia desde a \xE1gora."
        conditions: []
        effects:
        - flag: met_menexeno
          value: true
        choices: []
      - speaker: kleia
        text: "O senhor estava no mercado. Veio rir tamb\xE9m?"
        conditions: []
        effects: []
        choices: []
      - speaker: menexeno
        text: "Riram de voc\xEA porque \xE9 menina do Cer\xE2mico. Ningu\xE9m riu do que importava: voc\xEA esperou o homem terminar de errar."
        conditions: []
        effects: []
        choices: []
      - speaker: menexeno
        text: "Isso n\xE3o se ensina. O resto, sim. Eu ensino. De gra\xE7a."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Ningu\xE9m ensina de gra\xE7a no Cer\xE2mico. Qual \xE9 o pre\xE7o?"
        conditions: []
        effects: []
        choices: []
      - speaker: menexeno
        text: "Uma condi\xE7\xE3o. Nunca aceite dinheiro por uma pergunta. Nem uma dracma, nem de quem puder pagar."
        conditions: []
        effects:
        - flag: menexeno_condition
          value: true
        choices: []
      - speaker: kleia
        text: "Por qu\xEA?"
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "Ele n\xE3o explica."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: E o senhor aprendeu com quem? Foi aluno de algum mestre?
        conditions: []
        effects: []
        choices: []
      - speaker: menexeno
        text: "Faz muito tempo. N\xE3o importa."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: menexeno_door_glance
    value:
      lines:
      - speaker: 
        text: "Menexeno desvia os olhos para a rua, na dire\xE7\xE3o dos tribunais, e muda de assunto depressa demais."
        conditions: []
        effects:
        - flag: menexeno_avoids_past
          value: true
        choices: []
      branches: []
  - key: menexeno_door_lesson
    value:
      lines:
      - speaker: menexeno
        text: "Amanh\xE3, quando algu\xE9m disser uma certeza, n\xE3o aponte o erro. Pergunte at\xE9 ele trope\xE7ar sozinho. A m\xE3e dele era parteira; ele dizia que s\xF3 ajudava as ideias a nascer."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: Ele quem?
        conditions: []
        effects: []
        choices: []
      - speaker: menexeno
        text: "Ningu\xE9m. Boa noite, menina."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: menexeno_door_learned
    value:
      lines:
      - speaker: 
        text: "Kleia aprendeu a MAI\xCAUTICA. No debate, escolha a premissa fr\xE1gil do advers\xE1rio e deixe que ele se contradiga sozinho."
        conditions: []
        effects:
        - flag: maieutics_unlocked
          value: true
        choices: []
      branches: []
  - key: kerameikos_leaving_workshop
    value:
      lines:
      - speaker: kleia
        text: "As m\xE3os do meu pai j\xE1 n\xE3o fecham em volta de uma \xE2nfora. Hoje sou eu quem leva a mercadoria \xE0 \xE1gora."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Pela rua de terra at\xE9 a herma, depois o mercado. Vender, receber e voltar. Sem parar para ouvir discuss\xE3o alheia."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: Ela sabe que vai parar.
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: agora_after_thrasybios
    value:
      lines:
      - speaker: kleia
        text: "As \xE2nforas j\xE1 est\xE3o vendidas. Meu pai deve estar me esperando na oficina."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "A rua de terra, depois da herma, leva de volta ao Cer\xE2mico."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: neighbor_kerameikos
    value:
      lines:
      - speaker: neighbor
        text: "Filha de Aristeu! Vai levar as \xE2nforas \xE0 \xE1gora? Cuidado com o sujeito de p\xFArpura perto das bancas."
        conditions:
        - flag: talked_to_neighbor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: Que sujeito?
        conditions:
        - flag: talked_to_neighbor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: neighbor
        text: "Um tal de Thrasybios. Vende a arte de vencer qualquer discuss\xE3o por tr\xEAs dracmas. E vence mesmo quando est\xE1 errado."
        conditions:
        - flag: talked_to_neighbor
          value: 
          absent: 1
        effects:
        - flag: talked_to_neighbor
          value: true
        - flag: heard_of_thrasybios
          value: true
        choices: []
      - speaker: neighbor
        text: "A \xE1gora fica depois da herma, no fim da rua. Boas vendas, menina."
        conditions:
        - flag: talked_to_neighbor
          value: 
          absent: 0
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: neighbor
        text: "Filha de Aristeu... N\xE3o leve a mal, mas prefiro n\xE3o ser visto conversando com voc\xEA. O homem de p\xFArpura anda dizendo coisas."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        - flag: pressure_deserted
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: neighbor
        text: "Seu pai me ofereceu a roda ontem. Eu n\xE3o tinha como pagar. Ningu\xE9m quer pagar a ele, desde que falam de voc\xEA."
        conditions:
        - flag: pressure_deserted
          value: 
          absent: 0
        - flag: pressure_tools
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: neighbor
        text: Vi quando levaram a roda do seu pai rua abaixo. Sinto muito, menina. Sinto mesmo.
        conditions:
        - flag: pressure_tools
          value: 
          absent: 0
        effects: []
        choices: []
      branches: []
  - key: menexeno_agora
    value:
      lines:
      - speaker: 
        text: "Um velho de manto encardido, apoiado num bast\xE3o de oliveira, observa a feira sem comprar nada."
        conditions:
        - flag: met_menexeno
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: Procura alguma coisa, senhor?
        conditions:
        - flag: met_menexeno
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: "Ou veio ouvir o tal Thrasybios, que vende vit\xF3rias por tr\xEAs dracmas?"
        conditions:
        - flag: met_menexeno
          value: 
          absent: 1
        - flag: heard_of_thrasybios
          value: 
          absent: 0
        - flag: headed_home
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: menexeno
        text: "Procuro quem saiba perguntar. Por enquanto, s\xF3 achei quem venda respostas."
        conditions:
        - flag: met_menexeno
          value: 
          absent: 1
        effects:
        - flag: met_menexeno
          value: true
        choices: []
      - speaker: menexeno
        text: "Deixe o homem de p\xFArpura terminar de falar. Quem erra costuma avisar antes."
        conditions:
        - flag: met_menexeno
          value: 
          absent: 0
        - flag: headed_home
          value: 
          absent: 1
        - flag: maieutics_unlocked
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: menexeno
        text: "Aqui n\xE3o, menina. V\xE1 para casa. Eu ando devagar, mas chego."
        conditions:
        - flag: met_menexeno
          value: 
          absent: 0
        - flag: headed_home
          value: 
          absent: 0
        - flag: maieutics_unlocked
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: menexeno
        text: "Pergunte. N\xE3o cobre. \xC9 s\xF3 isso que eu pe\xE7o."
        conditions:
        - flag: maieutics_unlocked
          value: 
          absent: 0
        effects: []
        choices: []
      - speaker: menexeno
        text: "J\xE1 dei respostas demais na vida. Nenhuma prestou."
        conditions:
        - flag: maieutics_unlocked
          value: 
          absent: 0
        - flag: menexeno_avoids_past
          value: 
          absent: 0
        effects: []
        choices: []
      - speaker: menexeno
        text: "Asebeia. A \xFAltima vez que ouvi essa palavra dita assim, em voz alta, foi num tribunal."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        - flag: damaris_branch
          value: undecided
          absent: 0
        effects: []
        choices: []
      - speaker: menexeno
        text: "N\xE3o terminou bem para ningu\xE9m. Cuidado com quem aplaude, menina."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        - flag: damaris_branch
          value: undecided
          absent: 0
        effects: []
        choices: []
      - speaker: menexeno
        text: "Soube da estrangeira de Abdera. E soube que voc\xEA disse n\xE3o."
        conditions:
        - flag: menexeno_respect
          value: 
          absent: 0
        effects: []
        choices: []
      - speaker: menexeno
        text: "Poucos dizem n\xE3o a Abdera. Fez bem."
        conditions:
        - flag: menexeno_respect
          value: 
          absent: 0
        effects: []
        choices: []
      - speaker: menexeno
        text: "Tr\xEAs dias pensando se voltava. Voltei. Mas a bolsa que ela te deu pesa mais do que parece."
        conditions:
        - flag: damaris_branch
          value: accepted
          absent: 0
        effects: []
        choices: []
      - speaker: menexeno
        text: "E o rapaz do compasso? Repete Plat\xE3o como quem decora uma receita. Ainda n\xE3o provou o prato."
        conditions:
        - flag: met_menexeno
          value: 
          absent: 0
        - flag: met_eudoro
          value: 
          absent: 0
        effects: []
        choices: []
      branches: []
  - key: eudoro_agora
    value:
      lines:
      - speaker: eudoro
        text: "Uma oleira na \xE1gora, e sem \xE2nfora nas m\xE3os? Que curioso."
        conditions:
        - flag: met_eudoro
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: "\xC2nforas n\xE3o discutem. Por isso fazem boa companhia."
        conditions:
        - flag: met_eudoro
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: eudoro
        text: "Na Academia aprendemos que toda coisa imita a sua ideia. A sua, suponho, \xE9 a de vaso."
        conditions:
        - flag: met_eudoro
          value: 
          absent: 1
        effects:
        - flag: met_eudoro
          value: true
        choices: []
      - speaker: eudoro
        text: "Ainda aqui? Plat\xE3o diria que a \xE1gora \xE9 o reino da opini\xE3o. Eu apenas concordo com ele."
        conditions:
        - flag: met_eudoro
          value: 
          absent: 0
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: eudoro
        text: "Dizem pela \xE1gora que voc\xEA \xE9 \xEDmpia. Eu n\xE3o diria tanto. Diria que \xE9 uma oleira que confunde pergunta com argumento."
        conditions:
        - flag: met_eudoro
          value: 
          absent: 0
        - flag: pressure_rumor
          value: 
          absent: 0
        effects: []
        choices: []
      branches: []
  - key: thrasybios_tutorial_intro
    value:
      lines:
      - speaker: 
        text: "No meio do mercado, um homem de manto p\xFArpura sobe num caixote e junta gente \xE0 sua volta."
        conditions:
        - flag: saw_thrasybios_demo
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: thrasybios
        text: "Cidad\xE3os! A arte de vencer qualquer discuss\xE3o, por apenas tr\xEAs dracmas. Duvidam? Eu demonstro."
        conditions:
        - flag: saw_thrasybios_demo
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: thrasybios
        text: "Voc\xEA a\xED, fregu\xEAs. O que leva debaixo do bra\xE7o?"
        conditions:
        - flag: saw_thrasybios_demo
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: customer
        text: "Uma \xE2nfora. Acabei de comprar da filha de Aristeu."
        conditions:
        - flag: saw_thrasybios_demo
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: thrasybios
        text: "Uma \xE2nfora? Pois vou provar, diante de todos, que isso n\xE3o \xE9 uma \xE2nfora."
        conditions:
        - flag: saw_thrasybios_demo
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: "Espere. Essa \xE2nfora saiu da minha roda. Se vai falar dela, fale comigo."
        conditions:
        - flag: saw_thrasybios_demo
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: 
        text: "A plateia abre uma roda em volta dos dois. O debate come\xE7ou."
        conditions:
        - flag: saw_thrasybios_demo
          value: 
          absent: 1
        effects:
        - flag: saw_thrasybios_demo
          value: true
        choices: []
      branches: []
  - key: thrasybios_tutorial_argument
    value:
      lines:
      - speaker: 
        text: "Todo argumento se apoia em premissas. Se uma delas troca o sentido de uma palavra, a conclus\xE3o desaba junto."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "Thrasybios chamou de \xE2nfora s\xF3 o vaso ritual das Panateneias. Mas todo oleiro chama de \xE2nfora qualquer vaso de duas al\xE7as."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "Uma refuta\xE7\xE3o certa derruba a Coer\xEAncia dele e puxa a plateia para o seu lado."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: Para apontar o erro, escolha REFUTAR no menu.
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: thrasybios_tutorial_fallacies
    value:
      lines:
      - speaker: 
        text: "Agora diga qual fal\xE1cia ele cometeu. Quando a mesma palavra muda de sentido no meio do argumento, a fal\xE1cia se chama Equ\xEDvoco."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: thrasybios_tutorial_miss
    value:
      lines:
      - speaker: 
        text: "N\xE3o era essa. Aqui o erro n\xE3o custa nada, e ele vai repetir o mesmo argumento. Procure a palavra que muda de sentido entre as premissas."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: thrasybios_tutorial_reminder
    value:
      lines:
      - speaker: 
        text: "O erro de Thrasybios continua na mesa. Escolha REFUTAR para apont\xE1-lo."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: agora_wrong_laughter
    value:
      lines:
      - speaker: 
        text: "Thrasybios fica sem resposta. Por um instante, a \xE1gora inteira se cala."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "Ent\xE3o a plateia explode em gargalhadas. Mas ningu\xE9m aponta para ele: todos apontam para Kleia."
        conditions: []
        effects: []
        choices: []
      - speaker: crowd
        text: "A filha do oleiro dando aula de l\xF3gica! Amanh\xE3 a \xE2nfora sobe na tribuna!"
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "Riem dela, n\xE3o com ela. Uma garota do Cer\xE2mico vencer um mestre \xE9 piada, n\xE3o feito."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Eu estava certa. Por que est\xE3o rindo?"
        conditions: []
        effects: []
        choices: []
      - speaker: thrasybios
        text: "Porque estar certa n\xE3o enche bolsa, menina. Viu s\xF3? At\xE9 perdendo eu junto plateia. Publicidade \xE9 publicidade."
        conditions: []
        effects: []
        choices: []
      - speaker: thrasybios
        text: "Tenho uma proposta: aulas comigo, tr\xEAs dracmas por semana. Voc\xEA aprende a vencer e a ser aplaudida. Aceita?"
        conditions: []
        effects: []
        choices:
        - text: Aceitar as aulas
          effects:
          - flag: thrasybios_lessons
            value: accepted
          branch: 0
        - text: Recusar
          effects:
          - flag: thrasybios_lessons
            value: refused
          branch: 1
      - speaker: 
        text: "A roda se desfaz. Algu\xE9m ainda imita a voz dela ao passar pelas bancas."
        conditions: []
        effects: []
        choices: []
      branches:
      - lines:
        - speaker: kleia
          text: "Est\xE1 bem. Quero entender por que aplaudem voc\xEA e riem de mim."
          conditions: []
          effects: []
          choices: []
        - speaker: thrasybios
          text: "Primeira li\xE7\xE3o, de gra\xE7a: a verdade \xE9 o que a plateia leva para casa."
          conditions: []
          effects: []
          choices: []
      - lines:
        - speaker: kleia
          text: "N\xE3o. O que aprendi hoje n\xE3o me custou nada, e n\xE3o vou vender."
          conditions: []
          effects: []
          choices: []
        - speaker: thrasybios
          text: "Orgulho tamb\xE9m tem pre\xE7o. Quando a bolsa apertar, voc\xEA volta."
          conditions: []
          effects: []
          choices: []
  - key: agora_asebeia_rumor
    value:
      lines:
      - speaker: 
        text: "Junto \xE0s bancas, Thrasybios sobe de novo no caixote. Desta vez n\xE3o vende nada: aponta."
        conditions: []
        effects: []
        choices: []
      - speaker: thrasybios
        text: "Cidad\xE3os! Conhecem a filha do oleiro? A menina que responde a homem feito com pergunta?"
        conditions: []
        effects: []
        choices: []
      - speaker: thrasybios
        text: "Perguntem a ela sobre Atena, sobre Zeus. Ela pergunta at\xE9 voc\xEAs duvidarem. Em Atenas isso tem nome: asebeia."
        conditions: []
        effects: []
        choices: []
      - speaker: crowd
        text: "Aseb\xE9s! A oleira \xE9 aseb\xE9s!"
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Eu perguntei o que ele queria dizer com \xE2nfora. S\xF3 isso."
        conditions: []
        effects: []
        choices: []
      - speaker: 
        text: "Ningu\xE9m escuta. Uma palavra como asebeia n\xE3o precisa de prova. Precisa de repeti\xE7\xE3o."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: agora_asebeia_spreads
    value:
      lines:
      - speaker: 
        text: Na fonte, duas mulheres param de falar quando Kleia passa. Um menino aponta para ela e sai correndo.
        conditions: []
        effects: []
        choices: []
      - speaker: crowd
        text: "\xC9 a \xEDmpia do Cer\xE2mico! A que ensina a duvidar dos deuses!"
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Ningu\xE9m nesta \xE1gora me ouviu falar dos deuses. Nem uma vez."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: agora_pressure_home
    value:
      lines:
      - speaker: kleia
        text: "Faz dias que ningu\xE9m compra uma \xE2nfora do meu pai. Nem aqui, nem na porta da oficina."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Preciso voltar ao Cer\xE2mico e ver como ele est\xE1."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: customer_oil
    value:
      lines:
      - speaker: customer
        text: "Vim buscar duas \xE2nforas para o azeite. As de Aristeu n\xE3o vazam. As da outra rua choram \xF3leo pela barriga."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: "\xC9 o barro do rio. Meu pai n\xE3o aceita outro."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: customer
        text: "Ouvi na \xE1gora que a filha de Aristeu ensina a duvidar dos deuses."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        effects: []
        choices: []
      - speaker: kleia
        text: "Eu perguntei a um homem o que ele queria dizer com \xE2nfora. Foi s\xF3 isso."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        effects: []
        choices: []
      - speaker: customer
        text: "Os deuses talvez n\xE3o se ofendam com perguntas. Os vizinhos, sim. Volto outro dia, menina."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        effects: []
        choices: []
      branches: []
  - key: customer_crater
    value:
      lines:
      - speaker: customer
        text: "Dizem que ningu\xE9m no Cer\xE2mico pinta um meandro t\xE3o fino quanto o de Aristeu."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: kleia
        text: "Os meandros s\xE3o meus. As m\xE3os dele j\xE1 n\xE3o seguram o pincel."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: customer
        text: "Ent\xE3o diga a ele que a filha merece o pre\xE7o. Levo a cratera grande."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 1
        effects: []
        choices: []
      - speaker: customer
        text: "Meu cunhado jura que viu voc\xEA na \xE1gora, discutindo com homem feito sobre os deuses."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        effects: []
        choices: []
      - speaker: kleia
        text: "Sobre uma \xE2nfora."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        effects: []
        choices: []
      - speaker: customer
        text: "Na boca de Thrasybios, d\xE1 no mesmo. Deixo a cratera para outra semana."
        conditions:
        - flag: pressure_rumor
          value: 
          absent: 0
        effects: []
        choices: []
      branches: []
  - key: kerameikos_no_customers
    value:
      lines:
      - speaker: 
        text: "Nenhum fregu\xEAs \xE0 porta da oficina. As \xE2nforas prontas continuam junto \xE0 entrada, e j\xE1 h\xE1 mais uma pilha ao lado delas."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Antes a fila chegava at\xE9 a rua."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: kerameikos_wheel_sold
    value:
      lines:
      - speaker: 
        text: "O canto da roda de oleiro est\xE1 vazio. No ch\xE3o de terra batida, s\xF3 ficou o c\xEDrculo claro onde ela girou por trinta anos."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Enquanto eu discutia na \xE1gora, ele vendia a roda."
        conditions: []
        effects: []
        choices: []
      branches: []
  - key: damaris_offer
    value:
      lines:
      - speaker: 
        text: "Uma mulher de peplos vermelho-terracota espera no meio da rua, im\xF3vel, as m\xE3os vazias. N\xE3o est\xE1 de passagem: est\xE1 esperando Kleia."
        conditions: []
        effects:
        - flag: met_damaris
          value: true
        choices: []
      - speaker: damaris
        text: "Kleia, filha de Aristeu. Meu nome \xE9 Damaris. Venho de Abdera, a cidade de Prot\xE1goras."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "N\xE3o conhe\xE7o ningu\xE9m de Abdera."
        conditions: []
        effects: []
        choices: []
      - speaker: damaris
        text: "Abdera conhece voc\xEA. Ouvi o que Thrasybios repete na \xE1gora: aseb\xE9s, \xEDmpia. Ele diz a palavra at\xE9 ela grudar."
        conditions: []
        effects: []
        choices: []
      - speaker: damaris
        text: E hoje cedo vi um homem descer esta rua com a roda do seu pai nas costas.
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: O que a senhora quer de mim?
        conditions: []
        effects: []
        choices: []
      - speaker: damaris
        text: "Fazer uma oferta. Prote\xE7\xE3o: ningu\xE9m diz \xEDmpia perto de quem anda comigo. Duzentas dracmas. E uma t\xE9cnica que Prot\xE1goras n\xE3o ensinava de gra\xE7a."
        conditions: []
        effects: []
        choices: []
      - speaker: damaris
        text: "Em troca, quando eu chamar, voc\xEA argumenta por mim. Onde eu disser, pelo lado que eu disser."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: E se o lado for o errado?
        conditions: []
        effects: []
        choices: []
      - speaker: damaris
        text: "Todo argumento pode ser refutado, Kleia. N\xE3o existe lado certo, s\xF3 lado bem defendido. Aceita?"
        conditions: []
        effects: []
        choices:
        - text: Aceitar a oferta
          effects:
          - flag: damaris_branch
            value: accepted
          branch: 0
        - text: Recusar
          effects:
          - flag: damaris_branch
            value: refused
          branch: 1
      - speaker: damaris
        text: "Atenas \xE9 pequena para quem pergunta. Nos veremos de novo."
        conditions: []
        effects: []
        choices: []
      branches:
      - lines:
        - speaker: kleia
          text: Aceito. Pela roda do meu pai.
          conditions: []
          effects: []
          choices: []
        - speaker: damaris
          text: "Pela roda, ent\xE3o. A t\xE9cnica \xE9 simples: quando atacarem voc\xEA, n\xE3o segure o golpe. Vire-o para a plateia."
          conditions: []
          effects: []
          choices: []
        - speaker: damaris
          text: "O velho do bast\xE3o n\xE3o vai gostar. Vai sumir por uns dias. Deixe. Em tr\xEAs dias ele volta, ou n\xE3o volta."
          conditions: []
          effects: []
          choices: []
      - lines:
        - speaker: kleia
          text: "N\xE3o. Prometi nunca aceitar dinheiro por uma pergunta."
          conditions:
          - flag: menexeno_condition
            value: 
            absent: 0
          effects: []
          choices: []
        - speaker: kleia
          text: "N\xE3o. O que eu pergunto n\xE3o tem dono."
          conditions:
          - flag: menexeno_condition
            value: 
            absent: 1
          effects: []
          choices: []
        - speaker: damaris
          text: Uma promessa feita a um velho que nem explica por que a pediu. Respeito. Poucos em Atenas guardam uma.
          conditions: []
          effects: []
          choices: []
        - speaker: damaris
          text: "Guarde ent\xE3o o que j\xE1 \xE9 seu. Voc\xEA escuta um homem errar antes de ele terminar a frase. Prot\xE1goras cobraria caro por isso."
          conditions: []
          effects: []
          choices: []
  - key: damaris_technique
    value:
      lines:
      - speaker: 
        text: "A bolsa pesa na m\xE3o de Kleia: duzentas dracmas. E ela aprendeu a INVERS\xC3O. Uma vez por debate, o primeiro ataque do advers\xE1rio vira aplauso para ela."
        conditions:
        - flag: damaris_branch
          value: accepted
          absent: 0
        effects: []
        choices: []
      - speaker: 
        text: "Kleia fica de m\xE3os vazias e com o que sempre teve: a ESCUTA. Uma vez por debate, ela ouve onde o primeiro argumento do advers\xE1rio range, e a premissa fraca se revela."
        conditions:
        - flag: damaris_branch
          value: refused
          absent: 0
        effects: []
        choices: []
      branches: []
  - key: agora_menexeno_gone
    value:
      lines:
      - speaker: 
        text: "Junto \xE0s colunas da stoa, onde Menexeno costuma se apoiar no bast\xE3o, n\xE3o h\xE1 ningu\xE9m."
        conditions: []
        effects: []
        choices: []
      - speaker: kleia
        text: "Ele j\xE1 sabe da bolsa. N\xE3o sei como, mas sabe."
        conditions: []
        effects: []
        choices: []
      branches: []
