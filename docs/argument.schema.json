{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argument",
  "description": "Opponent argument returned by the Cloud Function. The engine judges it; the model only writes it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["speech", "fallacy_id", "premises", "weak_premise", "tone"],
  "properties": {
    "speech": {
      "type": "string",
      "minLength": 40,
      "maxLength": 300
    },
    "fallacy_id": {
      "type": ["string", "null"],
      "enum": [
        "ad_hominem",
        "straw_man",
        "false_dilemma",
        "appeal_to_authority",
        "appeal_to_ignorance",
        "hasty_generalization",
        "slippery_slope",
        "appeal_to_emotion",
        "equivocation",
        "begging_the_question",
        "affirming_the_consequent",
        "denying_the_antecedent",
        "undistributed_middle",
        "four_terms",
        "invalid_disjunctive_syllogism",
        null
      ]
    },
    "premises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weak_premise": {
      "type": "integer",
      "minimum": 0
    },
    "tone": {
      "type": "string",
      "enum": ["arrogant", "mocking", "cunning", "theatrical", "calm", "solemn", "curious", "melancholic"]
    }
  }
}
